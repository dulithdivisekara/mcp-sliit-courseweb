{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sliitcoursewebmcp",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "courseweb-db",
			"database_id": "5c696013-4642-47e7-958f-865bb3397610"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "courseweb-media"
		}
	],
	"routes": [
		{
			"pattern": "sliitcoursewebmcp.kesaru.me",
			"custom_domain": true
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	}
}
